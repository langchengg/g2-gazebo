Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [ /Global Options1, /G2 Robot1 ]
      Splitter Ratio: 0.45
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 190; 204; 217
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 110; 120; 130
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Name: G2 Robot
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /g2/sim/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Names: false
      Show Axes: false
      Show Arrows: false
      Frames:
        All Enabled: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: world
      Distance: 3.4
      Focal Point: {X: 0, Y: 0, Z: 0.95}
      Pitch: 0.22
      Yaw: 0.79
      Near Clip Distance: 0.01
      Invert Z Axis: false
Window Geometry:
  Width: 800
  Height: 670
  X: 800
  Y: 0
  Displays:
    collapsed: true
  Hide Left Dock: true
  Hide Right Dock: true
